extends SceneTree

const Fleet = preload("res://vehicles/fleet_catalog.gd")
const Parts = preload("res://vehicles/performance_parts.gd")
const TEST_PATH := "user://performance_parts_ci_test.cfg"

func _initialize() -> void:
	call_deferred("check")

func check() -> void:
	# Keep the test completely separate from any player's real garage save.
	if FileAccess.file_exists(TEST_PATH):
		assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(TEST_PATH))==OK)
	assert(Parts.balance(TEST_PATH)==0)
	assert(Parts.level("kestrel","drive",TEST_PATH)==0)
	assert(not Parts.buy("kestrel","drive",TEST_PATH))
	assert(Parts.award_race(0.0,true,TEST_PATH)==0)
	assert(Parts.award_race(58.0,true,TEST_PATH)==175)
	assert(Parts.balance(TEST_PATH)==175)
	assert(Parts.buy("kestrel","drive",TEST_PATH))
	assert(Parts.balance(TEST_PATH)==50)
	assert(Parts.level("kestrel","drive",TEST_PATH)==1)
	assert(Parts.level("piledriver","drive",TEST_PATH)==0,"Parts must be chassis-specific")
	assert(not Parts.buy("kestrel","drive",TEST_PATH),"No overspending")
	var base: Resource=Fleet.definition(0)
	var tuned: Resource=Fleet.definition(0)
	Parts.apply_to_chassis(tuned,TEST_PATH)
	assert(is_equal_approx(tuned.acceleration,base.acceleration+0.75))
	assert(is_equal_approx(tuned.max_forward_speed,base.max_forward_speed+0.6))
	assert(is_equal_approx(tuned.lateral_grip,base.lateral_grip))
	assert(tuned.visual_scene==base.visual_scene)
	assert(tuned.cockpit_eye==base.cockpit_eye)
	assert(tuned.mount_points==base.mount_points)
	var other: Resource=Fleet.definition(1)
	var other_speed: float=other.max_forward_speed
	Parts.apply_to_chassis(other,TEST_PATH)
	assert(is_equal_approx(other.max_forward_speed,other_speed))
	assert(Parts.award_race(62.0,false,TEST_PATH)==150)
	assert(Parts.award_race(63.0,false,TEST_PATH)==150)
	assert(Parts.balance(TEST_PATH)==350)
	assert(Parts.buy("kestrel","drive",TEST_PATH))
	assert(Parts.level("kestrel","drive",TEST_PATH)==2)
	assert(Parts.balance(TEST_PATH)==50)
	assert(not Parts.buy("kestrel","drive",TEST_PATH))
	assert(Parts.award_race(71.0,false,TEST_PATH)==150)
	assert(Parts.buy("kestrel","stability",TEST_PATH))
	assert(Parts.level("kestrel","stability",TEST_PATH)==1)
	assert(Parts.balance(TEST_PATH)==75)
	assert(Parts.award_race(72.0,false,TEST_PATH)==150)
	assert(Parts.buy("kestrel","capacitor",TEST_PATH))
	assert(Parts.level("kestrel","capacitor",TEST_PATH)==1)
	tuned=Fleet.definition(0)
	Parts.apply_to_chassis(tuned,TEST_PATH)
	assert(tuned.lateral_grip>base.lateral_grip and tuned.yaw_rate>base.yaw_rate)
	assert(tuned.boost_recharge>base.boost_recharge)
	assert(tuned.boost_speed_bonus>base.boost_speed_bonus)
	assert(not Parts.buy("kestrel","unknown",TEST_PATH))
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(TEST_PATH))==OK)
	print("PERFORMANCE_PARTS_OK")
	quit()
