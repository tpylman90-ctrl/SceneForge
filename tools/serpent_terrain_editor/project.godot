config_version=5

[application]
config/name="Crimson Serpent Terrain3D Authoring"
run/main_scene="res://SerpentAuthoring.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver="vulkan"
rendering_device/driver.android="vulkan"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/fallback_to_opengl3=false

[editor_plugins]
enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")
